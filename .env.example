# ./.env.example

# QuoteFlow AI — example configuration.
# Copy this file to `.env` and change the values. `.env` is git-ignored.
# Never put real secrets in this file: it is committed to a public repo.

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=quoteflow_dev

# --- Backend connection string (used by the Rust server and sqlx-cli) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Must match the three values above.
DATABASE_URL=postgres://postgres:password@localhost:5432/quoteflow_dev


# Network address the API binds to
APP_HOST=0.0.0.0
APP_PORT=3000
